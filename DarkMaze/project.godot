[layer_names]

3d_physics/layer_1="Terrain"
3d_physics/layer_2="Player"
3d_physics/layer_3="Enemy"
3d_physics/layer_4="ItemEntity"
3d_physics/layer_5="MovableEntity"
3d_physics/layer_6="GrabbableEntity"
3d_physics/layer_7="StateEntity"
3d_physics/layer_8="Door"

[locale]

translations=PoolStringArray( "res://Resources/Data/Translations/Translations.en.translation", "res://Resources/Data/Translations/Translations.pl.translation" )
locale_filter=[ 0, [  ] ]

[logging]

file_logging/enable_file_logging=true

[mono]

debugger_agent/wait_timeout=500000

[physics]

3d/physics_engine="Bullet"

[rendering]

quality/shadows/filter_mode=2
environment/default_environment="res://Resources/Envs/DefaultEnv.res"
