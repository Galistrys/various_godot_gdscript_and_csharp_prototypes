; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Tactical RPG"
config/version="0.0.1"
run/main_scene="uid://cjksp6xdcwvt"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://icon.svg"

[autoload]

EventBus="*uid://csqgimf6emf0i"
ConfigurationService="*uid://coo5oel3e1pqg"
SettingsService="*uid://5flkrn387gqv"
LocalizationService="*uid://bwiiajejgjijd"
CursorService="*uid://byyja0rkxhcan"
InputService="*uid://b11054qdw0obv"
NavigationService="*uid://d2q107dwwd6ts"

[debug]

gdscript/warnings/untyped_declaration=1

[display]

window/size/viewport_width=960
window/size/viewport_height=540
window/size/window_width_override=1920
window/size/window_height_override=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
mouse_cursor/custom_image="uid://cbs443hhgs54x"
mouse_cursor/custom_image_hotspot=Vector2(2, 2)

[file_customization]

folder_colors={
"res://assets/": "purple",
"res://core/": "gray",
"res://debug/": "yellow",
"res://gameplay/": "blue",
"res://ui/": "green",
"res://world/": "red"
}

[gui]

theme/custom="uid://hlcn3apjnn6i"

[importer_defaults]

csv_translation={
&"delimiter": 1
}

