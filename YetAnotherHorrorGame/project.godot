[layer_names]

3d_physics/layer_1="Terrain"
3d_physics/layer_2="Player"
3d_physics/layer_3="Entity"
3d_physics/layer_4="Interactable"

[locale]

translations=PoolStringArray( "res://Resources/Translations/GUI.en.translation", "res://Resources/Translations/GUI.pl.translation", "res://Resources/Translations/Items.en.translation", "res://Resources/Translations/Items.pl.translation", "res://Resources/Translations/Notes.en.translation", "res://Resources/Translations/Notes.pl.translation", "res://Resources/Translations/Diaries.en.translation", "res://Resources/Translations/Diaries.pl.translation", "res://Resources/Translations/Transcripts.en.translation", "res://Resources/Translations/Transcripts.pl.translation" )

[logging]

file_logging/enable_file_logging=true
file_logging/log_path="user://EngineLogs/godot.log"
file_logging/max_log_files=10

[rendering]

quality/shadows/filter_mode=2
environment/default_environment="res://default_env.tres"
