; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

_global_script_classes=[{
"base": "Object",
"class": &"Chunk",
"language": &"GDScript",
"path": "res://terrain/chunk.gd"
}, {
"base": "RefCounted",
"class": &"ChunkMeshData",
"language": &"GDScript",
"path": "res://chunk_mesh_data.gd"
}, {
"base": "Object",
"class": &"ChunkMeshGenerator",
"language": &"GDScript",
"path": "res://terrain/chunk_mesh_generator.gd"
}, {
"base": "Node3D",
"class": &"EndlessTerrain",
"language": &"GDScript",
"path": "res://terrain/endless_terrain.gd"
}, {
"base": "Node3D",
"class": &"EndlessTerrainThreaded",
"language": &"GDScript",
"path": "res://terrain/endless_terrain_threaded.gd"
}, {
"base": "CharacterBody3D",
"class": &"FlyCamera",
"language": &"GDScript",
"path": "res://tools/fly_camera/fly_camera.gd"
}, {
"base": "Node3D",
"class": &"Terrain",
"language": &"GDScript",
"path": "res://terrain/terrain.gd"
}, {
"base": "RefCounted",
"class": &"TerrainChunk",
"language": &"GDScript",
"path": "res://terrain/terrain_chunk.gd"
}, {
"base": "RefCounted",
"class": &"TerrainNoiseTools",
"language": &"GDScript",
"path": "res://terrain/terrain_noise_tools.gd"
}]
_global_script_class_icons={
"Chunk": "",
"ChunkMeshData": "",
"ChunkMeshGenerator": "",
"EndlessTerrain": "",
"EndlessTerrainThreaded": "",
"FlyCamera": "",
"Terrain": "",
"TerrainChunk": "",
"TerrainNoiseTools": ""
}

[application]

config/name="TerrainSystem"
run/main_scene="res://scenes/game.scn"
config/features=PackedStringArray("4.0", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Constants="*res://tools/autoloads/constants.gd"
WorldMapData="*res://tools/autoloads/world_map_data.gd"

[debug]

gdscript/warnings/integer_division=0

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

