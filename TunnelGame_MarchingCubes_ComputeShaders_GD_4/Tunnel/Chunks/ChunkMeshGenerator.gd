static func generate_normals(verticies: PackedVector3Array) -> PackedVector3Array:
	var result: PackedVector3Array = PackedVector3Array()
	@warning_ignore(integer_division)
	result.resize(verticies.size())
	
	for i in range(0, result.size(), 3):
		var vec_1 = verticies[i]
		var vec_2 = verticies[i + 1]
		var vec_3 = verticies[i + 2]
		
		var normal = (vec_3 - vec_1).cross(vec_2 - vec_1)
		result[i] = normal
		result[i + 1] = normal
		result[i + 2] = normal
		
	
	return result

static func _vertex_interpolate(a, b, surface_level: float) -> Vector3:
	if abs(surface_level - a[3]) < 0.00001:
		return Vector3(a[0], a[1], a[2])
	if abs(surface_level - b[3]) < 0.00001:
		return Vector3(b[0], b[1], b[2])
	
	var mu: float = (surface_level - a[3]) / (b[3] - a[3])
	return Vector3(
		a[0] + mu * (b[0] - a[0]),
		a[1] + mu * (b[1] - a[1]),
		a[2] + mu * (b[2] - a[2])
	)

static func _get_value(
	x: int, y: int, z: int,
	values_data: PackedFloat32Array
) -> float:
	return values_data[CHUNK_SIZE_1_2 * z + CHUNK_SIZE_1 * y + x]

static func _generate_block(
	x: int, y: int, z: int,
	detail_level: int, surface_level: float,
	vertices: Array,
	values_data: PackedFloat32Array
) -> void:
	var grid: Array[Array] = [
		[x, y, z],
		[x + detail_level, y, z],
		[x + detail_level, y + detail_level, z],
		[x, y + detail_level, z],
		[x, y, z + detail_level],
		[x + detail_level, y, z + detail_level],
		[x + detail_level, y + detail_level, z + detail_level],
		[x, y + detail_level, z + detail_level]
	]
	
	var value: int = 0
	for i in range(8):
		var c_grid = grid[i]
#		c_grid.append(_get_value(
#			c_grid[0], c_grid[1], c_grid[2], chunk_size, values_data
#		))
		c_grid.append(_get_value(
			c_grid[0], c_grid[1], c_grid[2], values_data
		))
		if c_grid[3] > surface_level:
			value |= 1 << i
	
	if EDGE_TABLE[value] == 0:
		return
	
	var vert_list: PackedVector3Array = PackedVector3Array()
	vert_list.resize(12)
	
	if EDGE_TABLE[value] & 1:
		vert_list[0] = _vertex_interpolate(grid[0], grid[1], surface_level)
	if EDGE_TABLE[value] & 2:
		vert_list[1] = _vertex_interpolate(grid[1], grid[2], surface_level)
	if EDGE_TABLE[value] & 4:
		vert_list[2] = _vertex_interpolate(grid[2], grid[3], surface_level)
	if EDGE_TABLE[value] & 8:
		vert_list[3] = _vertex_interpolate(grid[3], grid[0], surface_level)
	if EDGE_TABLE[value] & 16:
		vert_list[4] = _vertex_interpolate(grid[4], grid[5], surface_level)
	if EDGE_TABLE[value] & 32:
		vert_list[5] = _vertex_interpolate(grid[5], grid[6], surface_level)
	if EDGE_TABLE[value] & 64:
		vert_list[6] = _vertex_interpolate(grid[6], grid[7], surface_level)
	if EDGE_TABLE[value] & 128:
		vert_list[7] = _vertex_interpolate(grid[7], grid[4], surface_level)
	if EDGE_TABLE[value] & 256:
		vert_list[8] = _vertex_interpolate(grid[0], grid[4], surface_level)
	if EDGE_TABLE[value] & 512:
		vert_list[9] = _vertex_interpolate(grid[1], grid[5], surface_level)
	if EDGE_TABLE[value] & 1024:
		vert_list[10] = _vertex_interpolate(grid[2], grid[6], surface_level)
	if EDGE_TABLE[value] & 2048:
		vert_list[11] = _vertex_interpolate(grid[3], grid[7], surface_level)
	
	var triangulation: Array = TRI_TABLE[value]
	for i in range(0, 13, 3):
		if triangulation[i] != -1:
			vertices.append(vert_list[triangulation[i]])
			vertices.append(vert_list[triangulation[i + 1]])
			vertices.append(vert_list[triangulation[i + 2]])

static func generate_verticies(
	values_data: PackedFloat32Array,
	detail_level: int,
	surface_level: float
) -> PackedVector3Array:
	var vertices: Array = []
	
	for x in range(0, CHUNK_SIZE, detail_level):
		for y in range(0, CHUNK_SIZE, detail_level):
			for z in range(0, CHUNK_SIZE, detail_level):
				_generate_block(
					x, y, z,
					detail_level, surface_level,
					vertices, values_data
				)
	
	return PackedVector3Array(vertices)

static func generate_shape(
	vertices: PackedVector3Array
) -> ConcavePolygonShape3D:
	var shape: ConcavePolygonShape3D = ConcavePolygonShape3D.new()
	shape.set_faces(vertices)
	return shape

static func generate_mesh(
	vertices: PackedVector3Array,
	normals: PackedVector3Array
) -> ArrayMesh:
	var arrays: Array = []
	arrays.resize(Mesh.ARRAY_MAX)
	arrays[Mesh.ARRAY_VERTEX] = vertices
	arrays[Mesh.ARRAY_NORMAL] = normals
	
	var result: ArrayMesh = ArrayMesh.new()
	result.add_surface_from_arrays(
		Mesh.PRIMITIVE_TRIANGLES,
		arrays
	)
	
	var surface_tool = SurfaceTool.new()
	surface_tool.begin(Mesh.PRIMITIVE_TRIANGLES)
	surface_tool.create_from(result, 0)
	surface_tool.set_material(WorldMapData.tunnel_walls_material)
	surface_tool.index()
	result = surface_tool.commit()
	
	print("###################")
	print(result.surface_get_arrays(0))
	print("###################")
	
	return result
